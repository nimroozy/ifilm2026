# iFilm staging environment template.
# Copy via ./deploy/staging/scripts/prepare_env.sh (preferred) or manually.
# NEVER commit real secrets. NEVER leave REPLACE_* placeholders in a live .env.staging.
#
# DATABASE_URL and REDIS_URL are built by the container entrypoint from the
# component variables below (passwords with @ : / # % are percent-encoded).
# Do not set DATABASE_URL / REDIS_URL here.
#
# Live SAS Radius: DISABLED. RADIUS_ENTITLEMENT_MAPPING_ENABLED=false.
# Fixture auth is allowed ONLY because APP_ENV=staging + STAGING_ALLOW_FIXTURE_AUTH=true.

# --- Compose / Postgres ---
POSTGRES_DB=ifilm_staging
POSTGRES_USER=ifilm_staging
# Must include at least one of @ : / # so encoding is exercised in staging.
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD
STAGING_HTTP_PORT=8080

# --- Application ---
APP_NAME=iFilm API Staging
APP_ENV=staging
DEBUG=false
API_PREFIX=/api
CORS_ORIGINS=["https://staging.example.invalid","http://localhost:8080"]
CSP_MODE=production

# Required secrets (generate: openssl rand -hex 32)
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
PLAYBACK_TOKEN_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
PLAYBACK_TOKEN_TTL_SECONDS=3600

# Explicit seed only (optional). Never an unsafe default.
ADMIN_BOOTSTRAP_USERNAME=staging_admin
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD_MIN_12
ADMIN_BOOTSTRAP_EMAIL=staging-admin@example.invalid

# Redis (password required; URL built by entrypoint)
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_REQUIRED=true
WORKER_QUEUE_NAME=ifilm

# Media roots inside containers
MEDIA_ROOT=/data/media
ARTWORK_ROOT=/data/artwork
HLS_PUBLIC_BASE_URL=http://localhost:8080/api/stream

# --- Feature flags (staging media pipeline ON; Radius live OFF) ---
ENABLE_UPLOADS=true
ENABLE_ENCODING=false
ENABLE_CDN_SYNC=false
ENABLE_RADIUS_LOGIN=true
ENABLE_MEDIA_PROCESSING=true
ENABLE_HLS_ENCODING=true
ENABLE_LOCAL_STREAMING=true
ENABLE_WATCH_HISTORY=true

# --- Subscriber identity: fixture for staging smoke only ---
SUBSCRIBER_IDENTITY_MODE=fixture
STAGING_ALLOW_FIXTURE_AUTH=true
RADIUS_ENTITLEMENT_MAPPING_ENABLED=false
RADIUS_ENABLED=false
RADIUS_MODE=mock
RADIUS_SECRET=REPLACE_WITH_UNIQUE_RADIUS_PLACEHOLDER_NOT_USED_LIVE
RADIUS_SERVER=127.0.0.1
RADIUS_PORT=1812
RADIUS_NAS_IDENTIFIER=ifilm-staging
RADIUS_TIMEOUT_SECONDS=3
# Explicit fixture users for staging smoke tests (no production passwords).
RADIUS_MOCK_USERS=[{"username":"staging_user_001","password":"REPLACE_STAGING_FIXTURE_PASSWORD","package":"Premium 50Mbps","branch":"Kabul","expiration":"2027-12-31","name":"Staging Subscriber","account_status":"active","service_status":"active","max_devices":2}]

SUBSCRIBER_MAX_DEVICES_DEFAULT=2
ENTITLEMENT_CACHE_TTL_SECONDS=300
ENTITLEMENT_CACHE_GRACE_SECONDS=0
SUBSCRIBER_LOGIN_RATE_LIMIT=20
SUBSCRIBER_LOGIN_RATE_WINDOW_SECONDS=60

# Media processing
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MEDIA_PROCESSING_WORKER_ID=staging-media-1
MEDIA_PROCESSING_POLL_SECONDS=2
MEDIA_PROCESSING_STALE_AFTER_SECONDS=120
MEDIA_PROCESSING_MAX_ATTEMPTS=3
MEDIA_PROCESSING_RETRY_BASE_SECONDS=30
MEDIA_PROCESSING_PROBE_TIMEOUT_SECONDS=120
MEDIA_PROCESSING_ENCODE_TIMEOUT_SECONDS=3600
HLS_SEGMENT_DURATION_SECONDS=6
HLS_MAX_HEIGHT=1080
HLS_X264_PRESET=veryfast

# Upload limits
UPLOAD_MAX_BYTES=53687091200
UPLOAD_REJECT_DUPLICATE_CHECKSUM=true
