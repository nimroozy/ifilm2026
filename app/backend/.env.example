# Application
APP_NAME=iFilm API
APP_ENV=development
DEBUG=true
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL). SQLite is used automatically in tests.
DATABASE_URL=postgresql+psycopg2://ifilm:ifilm@localhost:5432/ifilm

# Auth
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin123
ADMIN_BOOTSTRAP_EMAIL=admin@ifilm.local

# Media / HLS
MEDIA_ROOT=./media
HLS_PUBLIC_BASE_URL=http://127.0.0.1:8000/media/hls
UPLOAD_MAX_BYTES=53687091200

# Redis / workers
REDIS_URL=redis://localhost:6379/0
WORKER_QUEUE_NAME=ifilm

# CDN
CDN_SYNC_ENABLED=true
CDN_HTTP_TIMEOUT_SECONDS=10

# SAS / FreeRADIUS integration
RADIUS_ENABLED=false
RADIUS_MODE=mock
RADIUS_SERVER=127.0.0.1
RADIUS_PORT=1812
RADIUS_SECRET=testing123
RADIUS_NAS_IDENTIFIER=ifilm
RADIUS_TIMEOUT_SECONDS=3
