# Application
APP_NAME=iFilm API
APP_ENV=development
DEBUG=false
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required. Example local Docker Compose credentials are NOT safe for staging/production.
DATABASE_URL=postgresql+psycopg2://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/ifilm

# Required. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Subscriber identity: fixture | radius | disabled
# fixture is only allowed when APP_ENV is development or test.
# When disabled, ENABLE_RADIUS_LOGIN + RADIUS_MODE still map to fixture/radius for compatibility.
SUBSCRIBER_IDENTITY_MODE=disabled
SUBSCRIBER_MAX_DEVICES_DEFAULT=3
ENTITLEMENT_CACHE_TTL_SECONDS=300
ENTITLEMENT_CACHE_GRACE_SECONDS=0
SUBSCRIBER_LOGIN_RATE_LIMIT=10
SUBSCRIBER_LOGIN_RATE_WINDOW_SECONDS=60

# Used only by the explicit seed command (`python -m scripts.seed_dev`).
# Do not set unsafe defaults such as admin123.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_EMAIL=admin@example.local

# Media / local storage
MEDIA_ROOT=./media
# Dedicated artwork tree served only at /artwork (never packages/originals/temp).
ARTWORK_ROOT=./artwork
# Legacy placeholder HLS base URL is unused; protected streaming uses /api/stream/{token}/…
HLS_PUBLIC_BASE_URL=http://127.0.0.1:8000/api/stream
UPLOAD_MAX_BYTES=53687091200
UPLOAD_ALLOWED_CONTENT_TYPES=video/mp4,video/x-matroska,video/webm,video/quicktime,video/x-msvideo,image/jpeg,image/png,image/webp,text/vtt,application/x-subrip,text/plain,application/octet-stream
UPLOAD_REJECT_DUPLICATE_CHECKSUM=true

# Redis / workers
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false
WORKER_QUEUE_NAME=ifilm

# Feature flags (all advanced features default OFF)
ENABLE_UPLOADS=false
ENABLE_ENCODING=false
ENABLE_CDN_SYNC=false
ENABLE_RADIUS_LOGIN=false
ENABLE_MEDIA_PROCESSING=false
ENABLE_HLS_ENCODING=false
ENABLE_LOCAL_STREAMING=false

# Watch history / Continue Watching (Phase 10)
ENABLE_WATCH_HISTORY=true
WATCH_PROGRESS_MIN_SECONDS=30
WATCH_PROGRESS_COMPLETE_PERCENT=90
WATCH_PROGRESS_SAVE_INTERVAL_SECONDS=20
WATCH_PROGRESS_RESUME_MARGIN_SECONDS=10
CONTINUE_WATCHING_LIMIT=20

# Required (≥32 chars) when ENABLE_LOCAL_STREAMING=true. Generate: openssl rand -hex 32
PLAYBACK_TOKEN_SECRET=
PLAYBACK_TOKEN_TTL_SECONDS=3600
PLAYBACK_ACCESS_TOUCH_SECONDS=30

# CSP: production | development | empty (derive from APP_ENV)
# CSP_MODE=production

# Optional absolute path to built SPA so the API serves HTML with CSP headers.
# FRONTEND_DIST=/absolute/path/to/app/frontend/dist

# Media processing worker (probe; HLS encode only when ENABLE_HLS_ENCODING=true)
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MEDIA_PROCESSING_WORKER_ID=
MEDIA_PROCESSING_POLL_SECONDS=2
MEDIA_PROCESSING_HEARTBEAT_SECONDS=10
MEDIA_PROCESSING_STALE_AFTER_SECONDS=120
MEDIA_PROCESSING_MAX_ATTEMPTS=3
MEDIA_PROCESSING_RETRY_BASE_SECONDS=30
MEDIA_PROCESSING_PROBE_TIMEOUT_SECONDS=120
MEDIA_PROCESSING_ENCODE_TIMEOUT_SECONDS=3600
MEDIA_PROCESSING_LOG_MAX_BYTES=65536
HLS_SEGMENT_DURATION_SECONDS=6
HLS_MAX_HEIGHT=1080
HLS_X264_PRESET=veryfast

CDN_HTTP_TIMEOUT_SECONDS=10

# SAS / FreeRADIUS (live mode is unverified)
RADIUS_ENABLED=false
RADIUS_MODE=live
RADIUS_SERVER=127.0.0.1
RADIUS_PORT=1812
RADIUS_SECRET=
RADIUS_NAS_IDENTIFIER=ifilm
RADIUS_TIMEOUT_SECONDS=3
# Development/test only. JSON list of explicit fixture users for mock mode.
# RADIUS_MODE=mock is rejected in staging/production.
RADIUS_MOCK_USERS=[]
