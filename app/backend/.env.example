# Application
APP_NAME=iFilm API
APP_ENV=development
DEBUG=false
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required. Example local Docker Compose credentials are NOT safe for staging/production.
DATABASE_URL=postgresql+psycopg2://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/ifilm

# Required. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Subscriber identity: fixture | radius | disabled | demo | portal
# DEFAULT: disabled. portal = Mobin Net portal.mns.af Voice AI (A1).
# Live SAS Radius authentication is unverified.
SUBSCRIBER_IDENTITY_MODE=disabled
SUBSCRIBER_MAX_DEVICES_DEFAULT=3
ENTITLEMENT_CACHE_TTL_SECONDS=300
ENTITLEMENT_CACHE_GRACE_SECONDS=0
SUBSCRIBER_LOGIN_RATE_LIMIT=10
SUBSCRIBER_LOGIN_RATE_WINDOW_SECONDS=60

# Portal.mns.af Voice AI (A1) — backend only. Never put the token in VITE_*.
# Feature-off by default. Do not enable in production until owner confirms
# credential rotation + staging smoke. Temporary shared Voice AI bearer is
# approved A1 v1 debt only; A1.1 requires a dedicated independently revocable
# iFilm secret. LIVE_QA: client/source are metadata, not authorization boundaries.
# Do not commit secrets. Never put the token in VITE_*.
PORTAL_AUTH_ENABLED=false
PORTAL_BASE_URL=https://portal.mns.af
PORTAL_VOICE_AI_PREFIX=/api/voice-ai/v1
PORTAL_VOICE_AI_TOKEN=
PORTAL_VOICE_AI_CLIENT=ifilm
PORTAL_REQUEST_SOURCE=ifilm
PORTAL_CONNECT_TIMEOUT_SECONDS=3
PORTAL_READ_TIMEOUT_SECONDS=5
PORTAL_ENTITLEMENT_CACHE_TTL_SECONDS=900
PORTAL_LOGIN_RATE_LIMIT=5
PORTAL_LOGIN_RATE_WINDOW_SECONDS=300

# Encrypt integration credentials in integration_configs (Fernet). Installer-generated.
INTEGRATION_SECRETS_KEY=

# Live Radius entitlement mapping — DISABLED by default.
# Access-Accept alone never grants playback entitlement.
RADIUS_ENTITLEMENT_MAPPING_ENABLED=false
# Required when mapping is enabled (staging-verified attribute names only):
# RADIUS_ATTR_PACKAGE=
# RADIUS_ATTR_EXPIRATION=
# Optional:
# RADIUS_ATTR_BRANCH=
# RADIUS_ATTR_ACCOUNT_STATUS=
# RADIUS_ATTR_SERVICE_STATUS=
# RADIUS_ATTR_MAX_DEVICES=

# Used only by the explicit seed command (`python -m scripts.seed_dev`).
# Do not set unsafe defaults such as admin123.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_EMAIL=admin@example.local

# Media / local storage
MEDIA_ROOT=./media
# Dedicated artwork tree served only at /artwork (never packages/originals/temp).
ARTWORK_ROOT=./artwork
# Optional TMDB-backed realistic demo catalog import. Leave disabled unless running
# `python -m scripts.seed_real_demo` or admin TMDB import tooling. Do not commit tokens.
TMDB_ENABLED=false
TMDB_API_READ_TOKEN=
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/
TMDB_LANGUAGE=en-US
TMDB_FALLBACK_LANGUAGE=en-US
TMDB_REQUEST_TIMEOUT_SECONDS=15
TMDB_CACHE_TTL_SECONDS=86400
# Legacy placeholder HLS base URL is unused; protected streaming uses /api/stream/{token}/…
HLS_PUBLIC_BASE_URL=http://127.0.0.1:8000/api/stream
UPLOAD_MAX_BYTES=53687091200
UPLOAD_ALLOWED_CONTENT_TYPES=video/mp4,video/x-matroska,video/webm,video/quicktime,video/x-msvideo,audio/mp4,audio/x-m4a,audio/aac,audio/mpeg,audio/mp3,image/jpeg,image/png,image/webp,text/vtt,application/x-subrip,text/plain,application/octet-stream
UPLOAD_REJECT_DUPLICATE_CHECKSUM=true

# Redis / workers
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false
WORKER_QUEUE_NAME=ifilm

# Feature flags (all advanced features default OFF)
ENABLE_UPLOADS=false
ENABLE_ENCODING=false
# Legacy experimental edge HTTP sync — keep false. Not the hybrid CDN foundation.
ENABLE_CDN_SYNC=false
ENABLE_RADIUS_LOGIN=false
ENABLE_MEDIA_PROCESSING=false
ENABLE_HLS_ENCODING=false
ENABLE_LOCAL_STREAMING=false

# Hybrid CDN / object storage Phase 1 (defaults OFF — local MEDIA_ROOT remains active)
# Central origin is S3-compatible (MinIO/Ceph). R2 is optional hot tier only.
ENABLE_OBJECT_STORAGE=false
MEDIA_ORIGIN_PROVIDER=local
# MEDIA_ORIGIN_ENDPOINT_URL=https://minio.example.internal:9000
# MEDIA_ORIGIN_REGION=us-east-1
# MEDIA_ORIGIN_BUCKET=
# MEDIA_ORIGIN_ACCESS_KEY_ID=
# MEDIA_ORIGIN_SECRET_ACCESS_KEY=
MEDIA_ORIGIN_FORCE_PATH_STYLE=true
MEDIA_OBJECT_KEY_PREFIX=ifilm
ENABLE_R2_HOT_TIER=false
# R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_REGION=auto
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Policy: R2 must not mirror the full library. Set a positive cap when enabling.
CDN_HOT_TIER_MAX_TITLES=0
CDN_HOT_TIER_COOLDOWN_DAYS=14
CDN_HOT_TIER_PROMOTE_VIEWS_THRESHOLD=0

# Watch history / Continue Watching (Phase 10)
ENABLE_WATCH_HISTORY=true
WATCH_PROGRESS_MIN_SECONDS=30
WATCH_PROGRESS_COMPLETE_PERCENT=90
WATCH_PROGRESS_SAVE_INTERVAL_SECONDS=20
WATCH_PROGRESS_RESUME_MARGIN_SECONDS=10
CONTINUE_WATCHING_LIMIT=20

# Required (≥32 chars) when ENABLE_LOCAL_STREAMING=true. Generate: openssl rand -hex 32
PLAYBACK_TOKEN_SECRET=
PLAYBACK_TOKEN_TTL_SECONDS=3600
PLAYBACK_ACCESS_TOUCH_SECONDS=30

# CSP: production | development | empty (derive from APP_ENV)
# CSP_MODE=production

# Optional absolute path to built SPA so the API serves HTML with CSP headers.
# FRONTEND_DIST=/absolute/path/to/app/frontend/dist

# Media processing worker (probe; HLS encode only when ENABLE_HLS_ENCODING=true)
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MEDIA_PROCESSING_WORKER_ID=
MEDIA_PROCESSING_POLL_SECONDS=2
MEDIA_PROCESSING_HEARTBEAT_SECONDS=10
MEDIA_PROCESSING_STALE_AFTER_SECONDS=120
MEDIA_PROCESSING_MAX_ATTEMPTS=3
MEDIA_PROCESSING_RETRY_BASE_SECONDS=30
MEDIA_PROCESSING_PROBE_TIMEOUT_SECONDS=120
MEDIA_PROCESSING_ENCODE_TIMEOUT_SECONDS=3600
MEDIA_PROCESSING_LOG_MAX_BYTES=65536
HLS_SEGMENT_DURATION_SECONDS=6
HLS_MAX_HEIGHT=1080
HLS_X264_PRESET=veryfast

CDN_HTTP_TIMEOUT_SECONDS=10

# SAS / FreeRADIUS (live mode is unverified)
RADIUS_ENABLED=false
RADIUS_MODE=live
RADIUS_SERVER=127.0.0.1
RADIUS_PORT=1812
RADIUS_SECRET=
RADIUS_NAS_IDENTIFIER=ifilm
RADIUS_TIMEOUT_SECONDS=3
# Development/test only. JSON list of explicit fixture users for mock mode.
# RADIUS_MODE=mock is rejected in staging/production.
RADIUS_MOCK_USERS=[]
