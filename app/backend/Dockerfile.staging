# Stage backend image for staging (non-root where practical).
FROM python:3.12-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ffmpeg \
    curl \
    gosu \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 ifilm \
    && useradd --system --uid 10001 --gid ifilm --home-dir /app --shell /usr/sbin/nologin ifilm

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
COPY docker/entrypoint.staging.sh /entrypoint.staging.sh
RUN chmod 755 /entrypoint.staging.sh \
    && rm -f /app/.env \
    && mkdir -p /data/media /data/artwork /run/ifilm \
    && chown -R ifilm:ifilm /app /data

ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    MEDIA_ROOT=/data/media \
    ARTWORK_ROOT=/data/artwork

# Entrypoint runs as root only to chown volumes, then drops to uid 10001.
USER root
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8000/api/health/live || exit 1

ENTRYPOINT ["/entrypoint.staging.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
