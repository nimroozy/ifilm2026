# Multi-stage production SPA build for staging nginx.
FROM node:22-alpine AS build

WORKDIR /src
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
ARG VITE_APP_VERSION=
ENV VITE_API_BASE_URL=/ \
    VITE_DATA_MODE=api \
    VITE_APP_VERSION=$VITE_APP_VERSION
RUN pnpm run build

# nginx 1.27-alpine is Alpine 3.21 (openssl 3.3.7-r1). Trivy flags actionable
# HIGH CVE-2026-75804/84782 with FixedVersion 3.3.7-r2, which is not published
# on 3.21; Alpine 3.23 ships openssl 3.5.9-r0 and clears the gate.
FROM nginx:1.28.3-alpine3.23 AS runtime
# Apply available Alpine security updates (defense in depth).
RUN apk update && apk upgrade --no-cache
COPY --from=build /src/dist /usr/share/nginx/html
COPY docker/nginx-spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=20s --timeout=5s --retries=5 CMD wget -qO- http://127.0.0.1/ || exit 1
