# Multi-stage production SPA build for staging nginx.
FROM node:22-alpine AS build

WORKDIR /src
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
ENV VITE_API_BASE_URL=/ \
    VITE_DATA_MODE=api
RUN pnpm run build

FROM nginx:1.27-alpine AS runtime
# Apply available Alpine security updates (actionable openssl/libcrypto fixes).
RUN apk update && apk upgrade --no-cache
COPY --from=build /src/dist /usr/share/nginx/html
COPY docker/nginx-spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=20s --timeout=5s --retries=5 CMD wget -qO- http://127.0.0.1/ || exit 1
