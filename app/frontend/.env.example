# Frontend (Vite) environment variables
# Copy to `.env` or `.env.local` for local development.

# Prefer same-origin `/api` (Vite proxies to BACKEND_PORT).
# Set an absolute URL only when the UI is not proxied to the API.
VITE_API_BASE_URL=/

# Catalog data source: mock (local fixtures) or api (backend). Default: mock
VITE_DATA_MODE=mock

# Dev server port (default: 3000)
VITE_PORT=3000

# Backend target for the Vite `/api` proxy (default: 8000)
BACKEND_PORT=8000

# Optional site metadata overrides
# VITE_APP_TITLE=iFilm
# VITE_APP_DESCRIPTION=iFilm streaming platform
# VITE_SITE_URL=https://example.com
# VITE_TWITTER_SITE=@ifilm
# VITE_TWITTER_CREATOR=@ifilm
